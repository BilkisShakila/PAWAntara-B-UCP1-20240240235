<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard Admin - Toko Sembako Ariesta</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 font-sans text-gray-800 flex flex-col min-h-screen">

    <!-- Top Bar -->
    <header class="bg-gray-900 text-white text-xs py-3 px-6 flex justify-between items-center">
        <div class="font-bold tracking-widest text-base">TOKO SEMBAKO ARIESTA - DASHBOARD</div>
        <div>
            <a href="/logout" class="bg-red-600 hover:bg-red-700 text-white px-3 py-1.5 rounded font-bold transition">Logout</a>
        </div>
    </header>

    <main class="flex-grow p-6 max-w-5xl mx-auto w-full">
        <div class="bg-white p-6 rounded-lg shadow-sm mb-8">
            <h2 class="text-lg font-bold mb-4 uppercase">Tambah Produk Baru</h2>
            
            <!-- Form Tambah Produk -->
            <form id="addProductForm" class="grid grid-cols-1 md:grid-cols-4 gap-4">
                <div>
                    <label class="block text-xs font-bold text-gray-700 mb-1">Nama Produk</label>
                    <input type="text" id="name" required class="border rounded px-3 py-2 text-xs w-full bg-gray-50">
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-700 mb-1">Harga (Rp)</label>
                    <input type="number" id="price" required class="border rounded px-3 py-2 text-xs w-full bg-gray-50">
                </div>
                <div>
                    <label class="block text-xs font-bold text-gray-700 mb-1">Stok</label>
                    <input type="number" id="stock" required class="border rounded px-3 py-2 text-xs w-full bg-gray-50">
                </div>
                <div class="flex items-end">
                    <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs uppercase py-2.5 rounded transition">
                        Tambah
                    </button>
                </div>
            </form>
        </div>

        <!-- Tabel Daftar Produk -->
        <div class="bg-white rounded-lg shadow-sm overflow-hidden">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-gray-50 border-b text-xs text-gray-500 uppercase">
                        <th class="p-4">Nama Produk</th>
                        <th class="p-4">Harga</th>
                        <th class="p-4">Stok</th>
                        <th class="p-4 text-center">Aksi</th>
                    </tr>
                </thead>
                <tbody class="divide-y text-xs">
                    <% products.forEach(product => { %>
                        <tr>
                            <td class="p-4 font-medium"><%= product.name %></td>
                            <td class="p-4">Rp <%= product.price.toLocaleString('id-ID') %></td>
                            <td class="p-4"><%= product.stock %></td>
                            <td class="p-4 text-center space-x-2">
                                <button onclick="editProduct('<%= product.id %>', '<%= product.name %>', '<%= product.price %>', '<%= product.stock %>')" class="bg-amber-500 hover:bg-amber-600 text-white px-3 py-1 rounded transition font-semibold">
                                    Edit
                                </button>
                                <button onclick="deleteProduct('<%= product.id %>')" class="bg-red-500 hover:bg-red-600 text-white px-3 py-1 rounded transition font-semibold">
                                    Hapus
                                </button>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </main>

    <!-- Script Fetch untuk CRUD (Tambah, Edit, Hapus) -->
    <script>
        document.getElementById('addProductForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const name = document.getElementById('name').value;
            const price = document.getElementById('price').value;
            const stock = document.getElementById('stock').value;

            const res = await fetch('/api/products', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ name, price, stock, category: 'sembako' })
            });

            const result = await res.json();
            if (res.ok) {
                alert(result.message);
                location.reload();
            } else {
                alert(result.message || 'Gagal menambah produk');
            }
        });

        async function deleteProduct(id) {
            if (!confirm('Yakin ingin menghapus produk ini?')) return;

            const res = await fetch(`/api/products/${id}`, {
                method: 'DELETE'
            });

            const result = await res.json();
            if (res.ok) {
                location.reload();
            } else {
                alert(result.message || 'Gagal menghapus produk');
            }
        }

        async function editProduct(id, oldName, oldPrice, oldStock) {
            const name = prompt("Edit Nama Produk:", oldName);
            if (name === null) return; // Batal jika klik cancel

            const price = prompt("Edit Harga Produk (Rp):", oldPrice);
            if (price === null) return;

            const stock = prompt("Edit Stok Produk:", oldStock);
            if (stock === null) return;

            const res = await fetch(`/api/products/${id}`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ name, price, stock })
            });

            const result = await res.json();
            if (res.ok) {
                alert(result.message);
                location.reload();
            } else {
                alert(result.message || 'Gagal memperbarui produk');
            }
        }
    </script>
</body>
</html>