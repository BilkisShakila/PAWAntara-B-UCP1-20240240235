<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Daftar Produk - Toko Sembako Ariesta</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-white font-sans text-gray-800 flex flex-col min-h-screen">

  <!-- Top Bar -->
  <header class="bg-gray-900 text-white text-xs py-2 px-6 flex justify-between items-center">
    <div class="font-bold tracking-widest text-base">TOKO SEMBAKO ARIESTA</div>
    <div class="flex items-center space-x-6">
      <span class="flex items-center gap-1 text-gray-300">
        <svg class="w-3.5 h-3.5 text-amber-500" fill="currentColor" viewBox="0 0 20 20"><path d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 110-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z"/></svg>
        LOKASI KAMI
      </span>
      <div class="relative">
        <input type="text" placeholder="Cari barang..." class="bg-gray-800 text-white px-3 py-1 rounded text-xs focus:outline-none pr-8">
        <svg class="w-3.5 h-3.5 text-gray-400 absolute right-2.5 top-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
      </div>
      <span class="text-amber-400 font-semibold">LAYANAN PESAN ANTAR! 0812-3456-7890</span>
    </div>
  </header>

  <!-- Navigation Menu -->
  <nav class="bg-white border-b border-gray-100 py-3 px-6 flex justify-center space-x-8 text-xs font-semibold tracking-wider text-gray-600 shadow-sm">
    <a href="/" class="hover:text-amber-500 transition">BERANDA</a>
    <a href="/produk" class="text-amber-500">PRODUK</a>
    <a href="/tanya-ai" class="hover:text-amber-500 transition">TANYA AI</a>
    <a href="/login" class="hover:text-amber-500 transition">LOGIN ADMIN</a>
  </nav>

  <!-- Hero Section Katalog -->
  <section class="relative bg-cover bg-center h-[240px] flex flex-col justify-center items-center text-center px-4" style="background-image: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), url('https://images.unsplash.com/photo-1542838132-92c53300491e?auto=format&fit=crop&w=1920&q=80')">
    <h1 class="text-white text-3xl md:text-4xl font-black uppercase tracking-wide drop-shadow-md">Produk Unggulan</h1>
    <p class="text-xs text-amber-400 tracking-widest uppercase mt-2">Sembako pilihan kualitas terbaik untuk keluarga</p>
  </section>

  <!-- Main Content: Daftar Produk -->
  <main class="flex-grow max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 w-full">
    
    <!-- Filter & Search Bar -->
    <div class="flex flex-col md:flex-row gap-4 mb-12 justify-center items-center">
      <input type="text" id="searchInput" placeholder="Cari nama produk..." class="border border-gray-200 bg-gray-50 rounded px-4 py-2.5 text-xs w-full md:w-1/3 focus:outline-amber-500 shadow-inner">
      <select id="categorySelect" class="border border-gray-200 bg-gray-50 rounded px-4 py-2.5 text-xs w-full md:w-1/5 focus:outline-amber-500 shadow-inner">
        <option value="">Semua Kategori</option>
        <option value="sembako">Sembako</option>
      </select>
    </div>

    <!-- Grid Produk -->
    <div id="productGrid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8">
      <div class="col-span-3 text-center text-gray-400 py-12">Memuat data produk...</div>
    </div>
  </main>

  <!-- Footer -->
  <footer class="bg-gray-900 text-gray-400 py-8 px-6 text-center text-xs mt-auto">
    <div class="flex justify-center space-x-4 mb-4">
      <a href="#" class="w-7 h-7 bg-gray-800 hover:bg-amber-500 text-white rounded-full flex items-center justify-center transition">f</a>
      <a href="#" class="w-7 h-7 bg-gray-800 hover:bg-amber-500 text-white rounded-full flex items-center justify-center transition">t</a>
      <a href="#" class="w-7 h-7 bg-gray-800 hover:bg-amber-500 text-white rounded-full flex items-center justify-center transition">G+</a>
      <a href="#" class="w-7 h-7 bg-gray-800 hover:bg-amber-500 text-white rounded-full flex items-center justify-center transition">in</a>
      <a href="#" class="w-7 h-7 bg-gray-800 hover:bg-amber-500 text-white rounded-full flex items-center justify-center transition">yt</a>
    </div>
    <div class="space-x-2 mb-2">
      <a href="#" class="hover:text-white">Privacy Policy</a>
      <span>|</span>
      <a href="#" class="hover:text-white">Terms of Use</a>
      <span>|</span>
      <a href="#" class="hover:text-white">Contact Support</a>
    </div>
    <p>Copyright © 2026 Toko Sembako Ariesta. Semua hak dilindungi | Beras, minyak, gula, telur, dan kebutuhan rumah tangga lainnya.</p>
  </footer>

  <!-- Script Dinamis untuk Fetch & Filtering Produk -->
  <script>
    const defaultImages = [
      'https://images.unsplash.com/photo-1586201375761-83865001e31c?auto=format&fit=crop&w=600&q=80',
      'https://images.unsplash.com/photo-1474979266404-7eaacbcd87c5?auto=format&fit=crop&w=600&q=80',
      'https://images.unsplash.com/photo-1581403337096-a234f9a0c8b9?auto=format&fit=crop&w=600&q=80',
      'https://images.unsplash.com/photo-1550989460-0adf9ea622e2?auto=format&fit=crop&w=600&q=80',
      'https://images.unsplash.com/photo-1563379091339-03b21ab4a4f8?auto=format&fit=crop&w=600&q=80'
    ];

    let allProducts = [];

    async function fetchProducts() {
      try {
        const res = await fetch('/api/products');
        const jsonRes = await res.json();
        allProducts = Array.isArray(jsonRes) ? jsonRes : (jsonRes.data || jsonRes.products || []);
        renderProducts(allProducts);
      } catch (err) {
        console.error('Gagal memuat produk:', err);
        document.getElementById('productGrid').innerHTML = `<div class="col-span-3 text-center text-red-500 py-12">Gagal memuat data produk dari server.</div>`;
      }
    }

    function renderProducts(productsToDisplay) {
      const grid = document.getElementById('productGrid');
      grid.innerHTML = '';

      if (productsToDisplay.length === 0) {
        grid.innerHTML = `<div class="col-span-3 text-center text-gray-400 py-12">Tidak ada produk yang cocok dengan pencarian.</div>`;
        return;
      }

      productsToDisplay.forEach((p, index) => {
        const name = p.name || p.nama || p.nama_produk || 'Produk Tanpa Nama';
        const price = p.price !== undefined && p.price !== null ? p.price : (p.harga || 0);
        const id = p.id || p._id || '#';
        // Pastikan gambar pakai properti p.image jika ada, atau gunakan gambar cadangan berurutan
        const imgSrc = p.image && p.image.trim() !== '' ? p.image : defaultImages[index % defaultImages.length];

        grid.innerHTML += `
          <a href="/produk/${id}" class="bg-white border border-gray-100 shadow-sm rounded overflow-hidden flex flex-col hover:shadow-md transition group">
            <div class="h-48 overflow-hidden bg-gray-100">
              <img src="${imgSrc}" alt="${name}" class="w-full h-full object-cover group-hover:scale-105 transition duration-300">
            </div>
            <div class="p-4 flex justify-between items-center bg-white mt-auto">
              <span class="text-gray-800 text-xs font-bold uppercase tracking-wider">${name}</span>
              <span class="text-amber-500 font-bold text-sm">Rp ${Number(price).toLocaleString('id-ID')}</span>
            </div>
          </a>
        `;
      });
    }

    // Event listener untuk Search & Filter kategori secara real-time
    document.getElementById('searchInput').addEventListener('input', filterProducts);
    document.getElementById('categorySelect').addEventListener('change', filterProducts);

    function filterProducts() {
      const keyword = document.getElementById('searchInput').value.toLowerCase();
      const selectedCategory = document.getElementById('categorySelect').value.toLowerCase();

      const filtered = allProducts.filter(p => {
        const name = (p.name || p.nama || '').toLowerCase();
        const category = (p.category || p.kategori || '').toLowerCase();

        const matchKeyword = name.includes(keyword);
        const matchCategory = selectedCategory === '' || category.includes(selectedCategory);

        return matchKeyword && matchCategory;
      });

      renderProducts(filtered);
    }

    // Panggil fungsi saat halaman pertama kali dibuka
    fetchProducts();
  </script>
</body>
</html>