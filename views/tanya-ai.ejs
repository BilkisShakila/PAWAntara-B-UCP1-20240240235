<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tanya AI - Toko Sembako Ariesta</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-white font-sans text-gray-800 flex flex-col min-h-screen">

  <!-- Top Bar (Gaya Senada Beranda & Produk) -->
  <header class="bg-gray-900 text-white text-xs py-2 px-6 flex justify-between items-center">
    <div class="font-bold tracking-widest text-base">TOKO SEMBAKO ARIESTA</div>
    <div class="flex items-center space-x-6">
      <span class="flex items-center gap-1 text-gray-300">
        <svg class="w-3.5 h-3.5 text-amber-500" fill="currentColor" viewBox="0 0 20 20"><path d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z"/></svg>
        LOKASI KAMI
      </span>
      <div class="relative">
        <input type="text" placeholder="Cari barang..." class="bg-gray-800 text-white px-3 py-1 rounded text-xs focus:outline-none pr-8">
        <svg class="w-3.5 h-3.5 text-gray-400 absolute right-2.5 top-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
      </div>
      <span class="text-amber-400 font-semibold">LAYANAN PESAN ANTAR! 0812-3456-7890</span>
    </div>
  </header>

  <!-- Navigation Menu -->
  <nav class="bg-white border-b border-gray-100 py-3 px-6 flex justify-center space-x-8 text-xs font-semibold tracking-wider text-gray-600 shadow-sm">
    <a href="/" class="hover:text-amber-500 transition">BERANDA</a>
    <a href="/produk" class="hover:text-amber-500 transition">PRODUK</a>
    <a href="/tanya-ai" class="text-amber-500">TANYA AI</a>
    <a href="/login" class="hover:text-amber-500 transition">LOGIN ADMIN</a>
  </nav>

  <!-- Hero Section Tanya AI -->
  <section class="relative bg-cover bg-center h-[240px] flex flex-col justify-center items-center text-center px-4" style="background-image: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), url('https://images.unsplash.com/photo-1542838132-92c53300491e?auto=format&fit=crop&w=1920&q=80')">
    <h1 class="text-white text-3xl md:text-4xl font-black uppercase tracking-wide drop-shadow-md">Tanya AI</h1>
    <p class="text-xs text-amber-400 tracking-widest uppercase mt-2">Punya pertanyaan seputar stok, harga, atau ongkir? Tanya di sini!</p>
  </section>

  <!-- Main Content: Area Chat AI -->
  <main class="flex-grow max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 w-full flex flex-col">
    
    <!-- Kotak Percakapan Chat -->
    <div id="chatContainer" class="bg-white border border-gray-200 rounded-lg shadow-sm p-6 h-[400px] overflow-y-auto mb-4 flex flex-col space-y-4">
      <div class="flex items-start">
        <div class="bg-amber-500 text-white text-xs px-4 py-2.5 rounded-2xl rounded-tl-none max-w-md shadow-sm">
          Halo! Ada yang bisa saya bantu seputar produk Toko Ariesta?
        </div>
      </div>
    </div>

    <!-- Form Input Pesan -->
    <form id="chatForm" class="flex gap-2">
      <input type="text" id="userInput" placeholder="Tulis pertanyaan kamu..." class="border border-gray-300 rounded px-4 py-2.5 text-xs flex-grow focus:outline-amber-500 shadow-inner">
      <button type="submit" class="bg-amber-500 hover:bg-amber-600 text-white font-bold text-xs uppercase px-6 py-2.5 rounded tracking-wider transition">Kirim</button>
    </form>
  </main>

  <!-- Footer -->
  <footer class="bg-gray-900 text-gray-400 py-8 px-6 text-center text-xs mt-auto">
    <div class="flex justify-center space-x-4 mb-4">
      <a href="#" class="w-7 h-7 bg-gray-800 hover:bg-amber-500 text-white rounded-full flex items-center justify-center transition">f</a>
      <a href="#" class="w-7 h-7 bg-gray-800 hover:bg-amber-500 text-white rounded-full flex items-center justify-center transition">t</a>
      <a href="#" class="w-7 h-7 bg-gray-800 hover:bg-amber-500 text-white rounded-full flex items-center justify-center transition">G+</a>
      <a href="#" class="w-7 h-7 bg-gray-800 hover:bg-amber-500 text-white rounded-full flex items-center justify-center transition">in</a>
      <a href="#" class="w-7 h-7 bg-gray-800 hover:bg-amber-500 text-white rounded-full flex items-center justify-center transition">yt</a>
    </div>
    <div class="space-x-2 mb-2">
      <a href="#" class="hover:text-white">Privacy Policy</a>
      <span>|</span>
      <a href="#" class="hover:text-white">Terms of Use</a>
      <span>|</span>
      <a href="#" class="hover:text-white">Contact Support</a>
    </div>
    <p>Copyright © 2026 Toko Sembako Ariesta. Semua hak dilindungi |  kebutuhan rumah tangga .</p>
  </footer>

  <!-- Script untuk fungsionalitas chat AI -->
  <script>
    const chatForm = document.getElementById('chatForm');
    const userInput = document.getElementById('userInput');
    const chatContainer = document.getElementById('chatContainer');

    chatForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const message = userInput.value.trim();
      if (!message) return;

      // Tampilkan pesan user
      chatContainer.innerHTML += `
        <div class="flex items-start justify-end">
          <div class="bg-gray-100 text-gray-800 text-xs px-4 py-2.5 rounded-2xl rounded-tr-none max-w-md shadow-sm">
            ${message}
          </div>
        </div>
      `;
      userInput.value = '';
      chatContainer.scrollTop = chatContainer.scrollHeight;

      // Simulasi / Proses pengiriman ke backend AI
      try {
        // Sesuaikan endpoint fetch jika backend kamu menggunakan rute khusus AI
        /*
        const response = await fetch('/api/tanya-ai', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ message })
        });
        const data = await response.json();
        */

        // Contoh balasan sementara (bisa disesuaikan dengan logika backend kamu)
        setTimeout(() => {
          chatContainer.innerHTML += `
            <div class="flex items-start">
              <div class="bg-amber-500 text-white text-xs px-4 py-2.5 rounded-2xl rounded-tl-none max-w-md shadow-sm">
                Terima kasih pertanyaannya. Silakan hubungi kontak layanan pesan antar kami untuk info ketersediaan barang secara langsung ya!
              </div>
            </div>
          `;
          chatContainer.scrollTop = chatContainer.scrollHeight;
        }, 500);

      } catch (err) {
        console.error('Gagal mengirim pesan:', err);
      }
    });
  </script>
</body>
</html>