<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login Admin - Toko Sembako Ariesta</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-white font-sans text-gray-800 flex flex-col min-h-screen">

  <!-- Top Bar (Gaya Senada) -->
  <header class="bg-gray-900 text-white text-xs py-2 px-6 flex justify-between items-center">
    <div class="font-bold tracking-widest text-base">TOKO SEMBAKO ARIESTA</div>
    <div class="flex items-center space-x-6">
      <span class="flex items-center gap-1 text-gray-300">
        <svg class="w-3.5 h-3.5 text-amber-500" fill="currentColor" viewBox="0 0 20 20"><path d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z"/></svg>
        LOKASI KAMI
      </span>
      <div class="relative">
        <input type="text" placeholder="Cari barang..." class="bg-gray-800 text-white px-3 py-1 rounded text-xs focus:outline-none pr-8">
        <svg class="w-3.5 h-3.5 text-gray-400 absolute right-2.5 top-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
      </div>
      <span class="text-amber-400 font-semibold">LAYANAN PESAN ANTAR! 0812-3456-7890</span>
    </div>
  </header>

  <!-- Navigation Menu -->
  <nav class="bg-white border-b border-gray-100 py-3 px-6 flex justify-center space-x-8 text-xs font-semibold tracking-wider text-gray-600 shadow-sm">
    <a href="/" class="hover:text-amber-500 transition">BERANDA</a>
    <a href="/produk" class="hover:text-amber-500 transition">PRODUK</a>
    <a href="/tanya-ai" class="hover:text-amber-500 transition">TANYA AI</a>
    <a href="/login" class="text-amber-500">LOGIN ADMIN</a>
  </nav>

  <!-- Hero Section Login -->
  <section class="relative bg-cover bg-center h-[200px] flex flex-col justify-center items-center text-center px-4" style="background-image: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), url('https://images.unsplash.com/photo-1542838132-92c53300491e?auto=format&fit=crop&w=1920&q=80')">
    <h1 class="text-white text-3xl md:text-4xl font-black uppercase tracking-wide drop-shadow-md">Area Admin</h1>
    <p class="text-xs text-amber-400 tracking-widest uppercase mt-2">Silakan masuk untuk mengelola produk toko</p>
  </section>

  <!-- Main Content: Form Login -->
  <main class="flex-grow flex items-center justify-center px-4 py-12 w-full">
    <div class="bg-white border border-gray-200 rounded-lg shadow-sm p-8 max-w-md w-full">
      <div class="text-center mb-6">
        <h2 class="text-xl font-extrabold text-gray-900 uppercase tracking-wide mb-1">Login Admin</h2>
        <p class="text-xs text-gray-500 uppercase tracking-wider">Masukkan akun pengelola Anda</p>
      </div>

      <!-- Form Login (Sesuaikan action/method dengan backend kamu jika diperlukan) -->
      <form action="/login" method="POST" class="space-y-4">
        <div>
          <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1.5">Username</label>
          <input type="text" name="username" placeholder="Masukkan username" required class="border border-gray-300 rounded px-4 py-2.5 text-xs w-full focus:outline-amber-500 shadow-inner bg-gray-50">
        </div>
        <div>
          <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1.5">Password</label>
          <input type="password" name="password" placeholder="Masukkan password" required class="border border-gray-300 rounded px-4 py-2.5 text-xs w-full focus:outline-amber-500 shadow-inner bg-gray-50">
        </div>
        <button type="submit" class="w-full bg-amber-500 hover:bg-amber-600 text-white font-bold text-xs uppercase py-3 rounded tracking-wider transition shadow-sm mt-2">
          Masuk
        </button>
      </form>
    </div>
  </main>

  <!-- Footer -->
  <footer class="bg-gray-900 text-gray-400 py-8 px-6 text-center text-xs mt-auto">
    <div class="flex justify-center space-x-4 mb-4">
      <a href="#" class="w-7 h-7 bg-gray-800 hover:bg-amber-500 text-white rounded-full flex items-center justify-center transition">f</a>
      <a href="#" class="w-7 h-7 bg-gray-800 hover:bg-amber-500 text-white rounded-full flex items-center justify-center transition">t</a>
      <a href="#" class="w-7 h-7 bg-gray-800 hover:bg-amber-500 text-white rounded-full flex items-center justify-center transition">G+</a>
      <a href="#" class="w-7 h-7 bg-gray-800 hover:bg-amber-500 text-white rounded-full flex items-center justify-center transition">in</a>
      <a href="#" class="w-7 h-7 bg-gray-800 hover:bg-amber-500 text-white rounded-full flex items-center justify-center transition">yt</a>
    </div>
    <div class="space-x-2 mb-2">
      <a href="#" class="hover:text-white">Privacy Policy</a>
      <span>|</span>
      <a href="#" class="hover:text-white">Terms of Use</a>
      <span>|</span>
      <a href="#" class="hover:text-white">Contact Support</a>
    </div>
    <p>Copyright © 2026 Toko Sembako Ariesta. Semua hak dilindungi | Beras, minyak, gula, telur, dan kebutuhan rumah tangga lainnya.</p>
  </footer>

</body>
</html>